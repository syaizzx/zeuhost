# =============================================================================
# ZeuHost Environment Configuration Template
# =============================================================================

# Server & Ingress
NODE_ENV=production
PORT=3000
HOST_DOMAIN=bot.example.com
PUBLIC_URL=https://bot.example.com

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://zeuhost:CHANGE_ME_DB_PASSWORD@postgres:5432/zeuhost?schema=public
POSTGRES_USER=zeuhost
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=zeuhost

# Authentication (Better Auth)
BETTER_AUTH_SECRET=CHANGE_ME_AUTH_SECRET_MIN_32_CHARS
BETTER_AUTH_URL=https://bot.example.com

# OAuth Providers (Configured per operator installation)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sensitive Data Encryption (32-byte hex or base64 key for AES-256-GCM)
INSTANCE_SECRET_KEY=CHANGE_ME_64_HEX_CHARACTERS_FOR_AES_256_GCM_ENCRYPTION

# Runtime Manager Control Channel
RUNTIME_MANAGER_URL=http://runtime-manager:4000
RUNTIME_MANAGER_HMAC_SECRET=CHANGE_ME_HMAC_SECRET_FOR_CONTROL_CHANNEL

# SMTP Configuration (Optional, fallback to console logs if blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Payment Gateway Configuration (MANUAL, TRIPAY, MIDTRANS)
PAYMENT_PROVIDER=MANUAL

# Manual Bank Transfer (Default - Safe, zero API key required)
MANUAL_BANK_NAME=BCA
MANUAL_ACCOUNT_NUMBER=8420198888
MANUAL_ACCOUNT_NAME="ZeuHost Operator"

# Tripay Payment Gateway (Optional - Automated QRIS, VA, E-Wallets)
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_IS_PRODUCTION=false

# Midtrans Gateway (Optional - Snap & Core API)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Automated Billing Cron Secret
CRON_SECRET=CHANGE_ME_CRON_SECRET_KEY

# Operational Defaults
REGISTRATION_MODE=OPEN
MAX_INSTANCES_PER_USER_DEFAULT=1
DEFAULT_STORAGE_LIMIT_MB=512
DEFAULT_MEMORY_LIMIT_MB=256
DEFAULT_CPU_LIMIT=0.5
